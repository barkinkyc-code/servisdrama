JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=8h
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ServisDrama <noreply@example.com>
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_PASSWORD=change-after-first-login

# Otomatik günlük rapor için yedek alıcılar (virgülle ayırın)
DAILY_SUMMARY_TO=
DAILY_SUMMARY_CC=
# Vercel Cron çağrısını korumak için Vercel panelinde tanımlayın
CRON_SECRET=

# Push bildirimleri (Web Push / VAPID — Firebase KULLANILMAZ).
# Üretmek için: node -e "console.log(require('web-push').generateVAPIDKeys())"
# PUBLIC anahtar tarayıcıya gönderilir (routes/push.js), gizli değildir.
# PRIVATE anahtar YALNIZCA sunucuda kalır, asla frontend'e veya repoya konmaz.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@dramagroup.com.tr
